# Run `uv run python scripts/configure.py` to generate local passwords.
RUSHES_DATABASE_URL=postgresql+psycopg://rushes_app:GENERATE@127.0.0.1:55432/rushes
RUSHES_ADMIN_DATABASE_URL=postgresql+psycopg://rushes_admin:GENERATE@127.0.0.1:55432/rushes
POSTGRES_PASSWORD=GENERATE
RUSHES_APP_PASSWORD=GENERATE
RUSHES_SECRET=GENERATE
RUSHES_STORAGE_ROOT=.local/storage
RUSHES_OUTPUT_ROOT=.local/exports
# JSON array of explicit absolute paths. No arbitrary browser directory scanning.
RUSHES_SOURCE_ROOTS=[]
RUSHES_ORIGIN=http://localhost:3741
# Maximum request-body duration; enforced by both the web server and API.
RUSHES_UPLOAD_TIMEOUT_SECONDS=7200
# Hosted only: an IP header overwritten by trusted ingress; never trust client input.
# RUSHES_CLIENT_IP_HEADER=x-rushes-ingress-client-ip
RUSHES_TEMPORAL_ADDRESS=127.0.0.1:7233
# Hosted single-service topology: provision and migrate these separate databases first.
RUSHES_HOST_WORKFLOW_SERVICE=false
# RUSHES_TEMPORAL_DATABASE_URL=postgresql://USER:PASSWORD@HOST/rushes_temporal?sslmode=verify-full
# RUSHES_TEMPORAL_VISIBILITY_DATABASE_URL=postgresql://USER:PASSWORD@HOST/rushes_temporal_visibility?sslmode=verify-full
RUSHES_GEMINI_API_KEY=
# Only this model is supported with the configured output/thinking limits.
RUSHES_GEMINI_MODEL=gemini-3.6-flash
# Default 20-second chunks; combined video/text is counted and capped before generation.
RUSHES_ANALYSIS_WINDOW_SECONDS=20
RUSHES_TRANSCRIPTION_MODEL=tiny
RUSHES_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RUSHES_MIN_FREE_BYTES=2147483648
RUSHES_LOCAL_CREDITS=600
RUSHES_MAX_ANALYSIS_CREDITS=120

# Use private Modal RPCs for speech and all embeddings, including search.
RUSHES_COMPUTE_BACKEND=local
RUSHES_MODAL_ENVIRONMENT=rushes-production
# Hosted allowance in USD micro-units; reserves conservative per-call exposure.
# RUSHES_PROVIDER_MONTHLY_ALLOWANCE_MICROUSD=2000000
